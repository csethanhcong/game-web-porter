<?xml version="1.0"?>
<?v1?>

<Animation>
    <Commands>
        <Command Target="Snd">
            <Execute Name="Play" Time="0"/>
        </Command>
    </Commands>
    <math::Vector[float,3]>
        <PrimitiveAnimation Target="#Shader#" Param="Emissive">
            <Envelope PreBehave="CONSTANT" PostBehave="CONSTANT">
                <Keys>
                    <Key Time="0" Linear="4 4 4" Value="0.6 0.6 0.6"/>
                    <Key Time="0.1" Linear="0 0 0" Value="1 1 1"/>
                </Keys>
            </Envelope>
        </PrimitiveAnimation>
    </math::Vector[float,3]>
</Animation>
