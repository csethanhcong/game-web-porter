<GameObject Type="Object">
    <GameObjectView ModelName="data/objects/tree_00_2x2.scene"/>

    <Properties>
        <Property Name="HitPoints" Value="2"/>
        <Property Name="Damage" Value="-1"/>
        <Property Name="DamageDouble" Value="-2"/>
        <Property Name="DamageRocket" Value="-3"/>
    </Properties>

    <Strategies>
        <StrategyRandomize ScaleMin="0.9 0.8 0.9" ScaleMax="1.1 1.4 1.1" RotationMax="0 3.1415 0"/>
    </Strategies>


    <GameObjectStates>
        <GameObjectState Name="Default" TemplateName="data/objects/object_collision.state">
            <GameObjectStateView AnimationName="data/objects/tree_00_2x2.anim" RandomStart="true"/>
            <Strategies>
                <StrategyChangeStateByCounter StateName="Exploding1" PropertyName="HitPoints" MinValue="-9999" MaxValue="2"/>
                <StrategyMask Mask = "1"/>
            </Strategies>
        </GameObjectState>

        <GameObjectState Name="Exploding1">
            <EventHandlers>
                <EventHandler>
                    <EventNames>
                        <EventName Name="AnimFinished"/>
                    </EventNames>
                    <Strategies>                    
                        <StrategyChangeState StateName="Death1"/>
                    </Strategies>
                 </EventHandler>
           </EventHandlers>
           <Strategies>
                <StrategyMask Mask = "1"/>
            </Strategies>
           <GameObjectStateView AnimationName="data/objects/tree_01_2x2_death1.anim" Loop="false"/>
        </GameObjectState>

        <GameObjectState Name="Death1" TemplateName="data/objects/object_collision.state" >
            <GameObjectStateView AnimationName="data/objects/tree_01_2x2.anim" RandomStart="true"/>
            <Strategies>
                <StrategyChangeStateByCounter StateName="Exploding2" PropertyName="HitPoints" MinValue="-9999" MaxValue="1"/>
                <StrategyMask Mask = "1"/>
            </Strategies>
        </GameObjectState>

        <GameObjectState Name="Exploding2">
            <EventHandlers>
                <EventHandler>
                    <EventNames>
                        <EventName Name="AnimFinished"/>
                    </EventNames>
                    <Strategies>                    
                        <StrategyChangeState StateName="Death2"/>
                    </Strategies>
                 </EventHandler>
           </EventHandlers>
           <Strategies>
                <StrategyMask Mask = "0"/>
            </Strategies>
           <GameObjectStateView AnimationName="data/objects/tree_01_2x2_death2.anim" Loop="false"/>
        </GameObjectState>

        <GameObjectState Name="Death2" TemplateName="data/objects/object_collision.state">
            <GameObjectStateView AnimationName="data/objects/tree_01_2x2.anim" RandomStart="true"/>
            <Strategies>
                <StrategyMask Mask = "0"/>
            </Strategies>
        </GameObjectState>

    </GameObjectStates>
</GameObject>
