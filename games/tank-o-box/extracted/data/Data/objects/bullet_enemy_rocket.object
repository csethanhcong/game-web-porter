<GameObject Type="EnemyBulletRocket">
    <Properties>
            <Property Name="Speed" Value="10"/>
    </Properties>
    
    <GameObjectView ModelName="data/objects/rocket.scene"/>
    
    <GameObjectStates>
        <GameObjectState Name="Default"             
                TemplateName="data/objects/collision_with_enemy.state"
                TemplateName="data/objects/collision_with_player.state"
                TemplateName="data/objects/collision_with_player_bullet.state"              
                TemplateName="data/objects/collision_with_object.state">
            <GameObjectStateView AnimationName="data/objects/rocket.anim"/>
            <Strategies>
                <StrategyMoveBullet CollisionState="Explode" Mask="1"/>
            </Strategies>
        </GameObjectState>

        <GameObjectState Name="Explode">
            <EventHandlers/>
            <Strategies>
                <StrategyMask Mask="0"/>
                <StrategyChangeState StateName="Dead"/>
            </Strategies>
        </GameObjectState>
        <GameObjectState Name="Dead"/>

    </GameObjectStates>
    


</GameObject>
