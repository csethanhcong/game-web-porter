<GameObject Type="Tank">
    <GameObjectView ModelName="data/objects/dot_3x3.scene"/>

    <Properties>
        <Property Name="HitPoints" Value="3"/>
        <Property Name="Damage" Value="-1"/>
        <Property Name="DamageDouble" Value="-2"/>
        <Property Name="DamageRocket" Value="-3"/>
	<Property Name="ExplodeScore" Value="2000"/>
    </Properties>

    <Strategies>
        <StrategyGlobalCounter PropertyName="TankCountEnemy"/>
    </Strategies>

    <GameObjectStates>
        <GameObjectState Name="Default" TemplateName="data/objects/tank_collision.state">
            <GameObjectStateView AnimationName="data/objects/dot_3x3.anim" Loop="false"/>
            <Strategies>
                <StrategyChangeStateByCounter StateName="Exploding1" PropertyName="HitPoints" MinValue="-9999" MaxValue="3"/>
                <StrategyFireByTime MinTime="1" MaxTime="2" TemplateName="data/objects/bullet_enemy.object"
                    FireMask0="010 000 000" FireMask1="000 001 000" FireMask2="000 000 010" FireMask3="000 100 000" />
                <StrategyMask Mask = "111 111 111"/>
			<StrategyShadow MainNode="live" ShadowName="shadow"/>
            </Strategies>
        </GameObjectState>

        <GameObjectState Name="Exploding1">
            <EventHandlers>
                <EventHandler>
                    <EventNames>
                        <EventName Name="AnimFinished"/>
                    </EventNames>
                    <Strategies>                    
                        <StrategyChangeState StateName="Death1"/>
                    </Strategies>
                 </EventHandler>
           </EventHandlers>
           <Strategies>
                <StrategyMask Mask = "111 111 111"/>
			<StrategyShadow MainNode="death0" ShadowName="shadow"/>
            </Strategies>
           <GameObjectStateView AnimationName="data/objects/death1.anim" 
                AnimationName="data/objects/explode_particles_6.anim"
                Loop="false"/>
        </GameObjectState>

        <GameObjectState Name="Death1" TemplateName="data/objects/tank_collision.state">
            <GameObjectStateView AnimationName="data/objects/dot_3x3.anim"/>
            <Strategies>
                <StrategyFireByTime MinTime="1" MaxTime="2" TemplateName="data/objects/bullet_enemy.object"
                    FireMask0="010 000 000" FireMask1="000 001 000" FireMask2="000 000 010" FireMask3="000 100 000" />
                <StrategyChangeStateByCounter StateName="Exploding2" PropertyName="HitPoints" MinValue="-9999" MaxValue="2"/>
                <StrategyMask Mask = "111 111 111"/>
			<StrategyShadow MainNode="death0" ShadowName="shadow"/>
            </Strategies>
        </GameObjectState>

        <GameObjectState Name="Exploding2">
            <EventHandlers>
                <EventHandler>
                    <EventNames>
                        <EventName Name="AnimFinished"/>
                    </EventNames>
                    <Strategies>                    
                        <StrategyChangeState StateName="Death2"/>
                    </Strategies>
                 </EventHandler>
           </EventHandlers>
           <Strategies>
                <StrategyMask Mask = "111 111 111"/>
			<StrategyShadow MainNode="death1" ShadowName="shadow"/>
            </Strategies>
           <GameObjectStateView AnimationName="data/objects/death2.anim" 
                AnimationName="data/objects/explode_particles_6.anim"
                Loop="false"/>
        </GameObjectState>

        <GameObjectState Name="Death2" TemplateName="data/objects/tank_collision.state">
            <GameObjectStateView AnimationName="data/objects/dot_3x3.anim"/>
            <Strategies>
                <StrategyFireByTime MinTime="1" MaxTime="2" TemplateName="data/objects/bullet_enemy.object"
                    FireMask0="010 000 000" FireMask1="000 001 000" FireMask2="000 000 010" FireMask3="000 100 000" />
                <StrategyChangeStateByCounter StateName="Exploding3" PropertyName="HitPoints" MinValue="-9999" MaxValue="1"/>
                <StrategyMask Mask = "111 111 111"/>
			<StrategyShadow MainNode="death1" ShadowName="shadow"/>
            </Strategies>
        </GameObjectState>

        <GameObjectState Name="Exploding3">
            <EventHandlers>
		<EventHandler>
                    <EventNames>
                        <EventName Name="AnimStart"/>
                    </EventNames>
                    <Strategies>                                    
                        <StrategyChangeGlobalCounter PropertyName="Score" StepPropertyName="ExplodeScore"/>
		    </Strategies>
		</EventHandler>
                <EventHandler>
                    <EventNames>
                        <EventName Name="AnimFinished"/>
                    </EventNames>
                    <Strategies>
                        <StrategyChangeState StateName="Death3"/>
                    </Strategies>
                 </EventHandler>
           </EventHandlers>
           <Strategies>             
                <StrategyGlobalCounter PropertyName="TankCountEnemy" Step="-1"/>
                <StrategyMask Mask = "000 000 000"/>
            </Strategies>
           <GameObjectStateView AnimationName="data/objects/death3.anim" 
                AnimationName="data/objects/explode_particles_6.anim"
		AnimationName="data/objects/scores/score.anim"
                Loop="false"/>
        </GameObjectState>

        <GameObjectState Name="Death3" TemplateName="data/objects/tank_collision.state">
            <Strategies>
                <StrategyGlobalCounter PropertyName="TankCountEnemy" Step="-1"/>
                <StrategyMask Mask = "000 000 000"/>
            </Strategies>
        </GameObjectState>
    </GameObjectStates>

</GameObject>
