<?xml version="1.0"?>
<?v1?>

<Animation>
    <Commands>
        <Command Target="snd_explode|snd">
            <Execute Name="Play" Time="0"/>
        </Command>
    </Commands>
    <Commands>
        <Command Target="snd_engine|snd">
            <Execute Name="Stop" Time="0"/>
        </Command>
    </Commands>
    <double>
            <PrimitiveAnimation Target="shield_tank_locator1" Param="Visibility">
            <Envelope PreBehave="CONSTANT" PostBehave="CONSTANT">
                <Keys>
                    <Key Time="0" Linear="0" Quadratic="0" Cubic="0" Value="1"/>
                    <Key Time="1" Linear="0" Quadratic="0" Cubic="0" Value="0"/>
                </Keys>
            </Envelope>
        </PrimitiveAnimation>
    </double>
</Animation>
