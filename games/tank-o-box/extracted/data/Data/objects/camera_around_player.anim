<?xml version="1.0"?>
<?v1?>

<Animation>
    <Commands>
        <Command Target="snd_win|snd">
            <Execute Name="Play" Time="0"/>
        </Command>
    </Commands>
    <math::Vector[float,3]>
        <PrimitiveAnimation Target="Camera" Param="Position">
            <Envelope PreBehave="CONSTANT" PostBehave="CONSTANT">
                <Keys>
                    <Key Time="0" Value="0 0 0"/>
                    <Key Time="5" Value="0 0 0"/>
                </Keys>
            </Envelope>
        </PrimitiveAnimation>
    </math::Vector[float,3]>
</Animation>
