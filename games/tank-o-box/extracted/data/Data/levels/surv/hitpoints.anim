<?xml version="1.0"?>
<?v1?>

<Animation>
    <double>
       <PrimitiveAnimation Target="" Param="Visibility">
            <Envelope PreBehave="CONSTANT" PostBehave="CONSTANT">
                <Keys>
                    <Key Time="0" Linear="0" Quadratic="0" Cubic="0" Value="1"/>
                </Keys>
            </Envelope>
        </PrimitiveAnimation>

        <PrimitiveAnimation Target="" Param="MorphWeight">
            <Envelope PreBehave="CONSTANT" PostBehave="CONSTANT">
                <Keys>
                    <Key Time="0" Linear="1" Quadratic="0" Cubic="0" Value="0"/>
                    <Key Time="1" Linear="0" Quadratic="0" Cubic="0" Value="1"/>
                </Keys>
            </Envelope>
        </PrimitiveAnimation>
    </double>
    <math::Vector[float,3]/>
</Animation>
