<?xml version="1.0"?>
<?v1?>

<Animation>
    <double>
        <PrimitiveAnimation Target="" Param="Visibility">
            <Envelope PreBehave="CONSTANT" PostBehave="CONSTANT">
                <Keys>
                    <Key Time="0" Linear="0" Quadratic="0" Cubic="0" Value="1"/>
                </Keys>
            </Envelope>
        </PrimitiveAnimation>
        <PrimitiveAnimation Target="Upgrade3" Param="Visibility">
            <Envelope PreBehave="CONSTANT" PostBehave="CONSTANT">
                <Keys>
                    <Key Time="0" Linear="0" Quadratic="0" Cubic="0" Value="0"/>
                    <Key Time="0.8" Linear="0" Quadratic="0" Cubic="0" Value="1"/>
                    <Key Time="1" Linear="0" Quadratic="0" Cubic="0" Value="1"/>
                </Keys>
            </Envelope>
        </PrimitiveAnimation>
        <PrimitiveAnimation Target="Upgrade2" Param="Visibility">
            <Envelope PreBehave="CONSTANT" PostBehave="CONSTANT">
                <Keys>
                    <Key Time="0" Linear="0" Quadratic="0" Cubic="0" Value="0"/>
                    <Key Time="0.5" Linear="0" Quadratic="0" Cubic="0" Value="1"/>
                    <Key Time="1" Linear="0" Quadratic="0" Cubic="0" Value="1"/>
                </Keys>
            </Envelope>
        </PrimitiveAnimation>
        <PrimitiveAnimation Target="Upgrade1" Param="Visibility">
            <Envelope PreBehave="CONSTANT" PostBehave="CONSTANT">
                <Keys>
                    <Key Time="0" Linear="0" Quadratic="0" Cubic="0" Value="0"/>
                    <Key Time="0.2" Linear="0" Quadratic="0" Cubic="0" Value="1"/>
                    <Key Time="1" Linear="0" Quadratic="0" Cubic="0" Value="1"/>
                </Keys>
            </Envelope>
        </PrimitiveAnimation>
        <PrimitiveAnimation Target="Upgrade0" Param="Visibility">
            <Envelope PreBehave="CONSTANT" PostBehave="CONSTANT">
                <Keys>
                    <Key Time="0" Linear="0" Quadratic="0" Cubic="0" Value="1"/>
                    <Key Time="1" Linear="0" Quadratic="0" Cubic="0" Value="1"/>
                </Keys>
            </Envelope>
        </PrimitiveAnimation>
    </double>
    <math::Vector[float,3]/>
</Animation>
