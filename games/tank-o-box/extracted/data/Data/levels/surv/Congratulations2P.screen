        <ControlLabel PropertyName="MenuScoreTotal" NodeName="ScoreTotal"/>
        <ControlButton Name="data/Interface/EmissiveButton_" NodeName="btnNext" Link="data/interface/HiScoreCooperativeGame.screen"/>
    </Controls>
</InterfaceScreenMenuScore>