<GameObject Type="Shtab">
    <GameObjectView ModelName="data/objects/shtab_6x6.scene"/>

	<Properties>
		<Property Name="HitPoints" Value="20"/>
		<Property Name="Damage" Value="-1"/>
	    <Property Name="DamageDouble" Value="-2"/>
	    <Property Name="DamageRocket" Value="-3"/>
	</Properties>

    <GameObjectStates>
		<GameObjectState Name="Default" TemplateName="data/objects/object_collision.state" TemplateName="data/objects/shtab_collision.state">
			<GameObjectStateView AnimationName="data/objects/shtab_6x6.anim"/>
			<Strategies>
				<StrategyChangeStateByCounter StateName="Exploding1" PropertyName="HitPoints" MinValue="-9999" MaxValue="16"/>
				<StrategyMask Mask = "111111 111111 111111 111111 111111 111111"/>
				<StrategyBonus TimePropertyName="BonusArmor" ValuePropertyName="Damage" NoBonusValue="-1" BonusValue="0" AnimationPath="data/objects/bonusshtab_"/>
				<StrategyBonus TimePropertyName="BonusArmor" ValuePropertyName="DamageDouble" NoBonusValue="-2" BonusValue="0"/>
				<StrategyBonus TimePropertyName="BonusArmor" ValuePropertyName="DamageRocket" NoBonusValue="-3" BonusValue="0"/>
				<StrategyShadow MainNode="live" ShadowName="shadow"/>
			</Strategies>
		</GameObjectState>

		<GameObjectState Name="Exploding1">
			<EventHandlers>
				<EventHandler>
	                <EventNames>
	                    <EventName Name="AnimFinished"/>
	                </EventNames>
	                <Strategies>                	
	                    <StrategyChangeState StateName="Death1"/>
	                </Strategies>
	             </EventHandler>
	       </EventHandlers>
	       <Strategies>
				<StrategyMask Mask = "111111 111111 111111 111111 111111 111111"/>
			<StrategyShadow MainNode="death0" ShadowName="shadow"/>
			</Strategies>
	       <GameObjectStateView AnimationName="data/objects/shtab_6x6_Death1.anim" Loop="false"/>
		</GameObjectState>

		<GameObjectState Name="Death1" TemplateName="data/objects/object_collision.state" TemplateName="data/objects/shtab_collision.state">
		    <GameObjectStateView AnimationName="data/objects/shtab_6x6.anim"/>
		    <Strategies>
		    	<StrategyChangeStateByCounter StateName="Exploding2" PropertyName="HitPoints" MinValue="-9999" MaxValue="11"/>
		    	<StrategyMask Mask = "111111 111111 111111 111111 111111 111111"/>
		    	<StrategyBonus TimePropertyName="BonusArmor" ValuePropertyName="Damage" NoBonusValue="-1" BonusValue="0" AnimationPath="data/objects/bonusshtab_"/>
				<StrategyBonus TimePropertyName="BonusArmor" ValuePropertyName="DamageDouble" NoBonusValue="-2" BonusValue="0"/>
				<StrategyBonus TimePropertyName="BonusArmor" ValuePropertyName="DamageRocket" NoBonusValue="-3" BonusValue="0"/>
			<StrategyShadow MainNode="death0" ShadowName="shadow"/>
		    </Strategies>
		</GameObjectState>

		<GameObjectState Name="Exploding2">
			<EventHandlers>
				<EventHandler>
	                <EventNames>
	                    <EventName Name="AnimFinished"/>
	                </EventNames>
	                <Strategies>                	
	                    <StrategyChangeState StateName="Death2"/>
	                </Strategies>
	             </EventHandler>
	       </EventHandlers>
	       <Strategies>
				<StrategyMask Mask = "111111 111111 111111 111111 111111 111111"/>
			<StrategyShadow MainNode="death1" ShadowName="shadow"/>
			</Strategies>
	       <GameObjectStateView AnimationName="data/objects/shtab_6x6_Death2.anim" Loop="false"/>
		</GameObjectState>

		<GameObjectState Name="Death2" TemplateName="data/objects/object_collision.state" TemplateName="data/objects/shtab_collision.state">
			<GameObjectStateView AnimationName="data/objects/shtab_6x6.anim"/>
		    <Strategies>
		    	<StrategyChangeStateByCounter StateName="Exploding3" PropertyName="HitPoints" MinValue="-9999" MaxValue="1"/>
		    	<StrategyMask Mask = "111111 111111 111111 111111 111111 111111"/>
		    	<StrategyBonus TimePropertyName="BonusArmor" ValuePropertyName="Damage" NoBonusValue="-1" BonusValue="0" AnimationPath="data/objects/bonusshtab_"/>
				<StrategyBonus TimePropertyName="BonusArmor" ValuePropertyName="DamageDouble" NoBonusValue="-2" BonusValue="0"/>
				<StrategyBonus TimePropertyName="BonusArmor" ValuePropertyName="DamageRocket" NoBonusValue="-3" BonusValue="0"/>
			<StrategyShadow MainNode="death1" ShadowName="shadow"/>
		    </Strategies>
		</GameObjectState>

		<GameObjectState Name="Exploding3">
			<EventHandlers>
				<EventHandler>
	                <EventNames>
	                    <EventName Name="AnimFinished"/>
	                </EventNames>
	                <Strategies>                	
	                    <StrategyChangeState StateName="Death3"/>
	                </Strategies>
	             </EventHandler>
	       </EventHandlers>
	       <Strategies>
				<StrategyMask Mask = "111111 111111 111111 111111 111111 111111"/>
			</Strategies>
	       <GameObjectStateView AnimationName="data/objects/shtab_6x6_Death3.anim" Loop="false"/>
		</GameObjectState>

		<GameObjectState Name="Death3" TemplateName="data/objects/object_collision.state" TemplateName="data/objects/shtab_collision.state">
			<GameObjectStateView AnimationName="data/objects/shtab_6x6.anim"/>
		    <Strategies>
		    	<StrategyGlobalEvent EventName="HQExplode"/>
		    	<StrategyMask Mask = "000000 000000 000000 000000 000000 000000"/>
				<StrategyBonus TimePropertyName="BonusArmor" ValuePropertyName="Damage" NoBonusValue="-1" BonusValue="0" AnimationPath="data/objects/bonusshtab_"/>
				<StrategyBonus TimePropertyName="BonusArmor" ValuePropertyName="DamageDouble" NoBonusValue="-2" BonusValue="0"/>
				<StrategyBonus TimePropertyName="BonusArmor" ValuePropertyName="DamageRocket" NoBonusValue="-3" BonusValue="0"/>
		    </Strategies>
		</GameObjectState>


    </GameObjectStates>

</GameObject>
