<GameObject Type="Object">
    <GameObjectView ModelName="data/objects/vagon_01_2x4.scene"/>

	<Properties>
		<Property Name="HitPoints" Value="2"/>
		<Property Name="Damage" Value="-1"/>
	    <Property Name="DamageDouble" Value="-2"/>
	    <Property Name="DamageRocket" Value="-3"/>
	</Properties>

    <GameObjectStates>
		<GameObjectState Name="Default" TemplateName="data/objects/object_collision.state">
			<GameObjectStateView AnimationName="data/objects/vagon_01_2x4.anim"/>
			<Strategies>
				<StrategyChangeStateByCounter StateName="Exploding1" PropertyName="HitPoints" MinValue="-9999" MaxValue="1"/>
				<StrategyMask Mask = "11 11 11 11"/>
				<StrategyShadow MainNode="live" ShadowName="shadow"/>
			</Strategies>
		</GameObjectState>

		<GameObjectState Name="Exploding1">
			<EventHandlers>
				<EventHandler>
	                <EventNames>
	                    <EventName Name="AnimFinished"/>
	                </EventNames>
	                <Strategies>                	
	                    <StrategyChangeState StateName="Death1"/>
	                </Strategies>
	             </EventHandler>
	       </EventHandlers>
	       <Strategies>
				<StrategyMask Mask = "00 00 00 00"/>
			</Strategies>
	       <GameObjectStateView AnimationName="data/objects/bochka_death1.anim" Loop="false"/>
		</GameObjectState>

		<GameObjectState Name="Death1" TemplateName="data/objects/object_collision.state">
		    <GameObjectStateView AnimationName="data/objects/vagon_01_2x4.anim"/>
		    <Strategies>
		    	<StrategyMask Mask = "00 00 00 00"/>
		    </Strategies>
		</GameObjectState>

    </GameObjectStates>

</GameObject>
