<GameObjectState>
	<EventHandlers>
		<EventHandler>
			<EventNames>
			    <EventName Name="CollisionPlayerNoUpgrade"/>
			    <EventName Name="CollisionPlayerUpgrade1"/>
			    <EventName Name="CollisionPlayerUpgrade2"/>
			    <EventName Name="CollisionPlayerUpgrade3"/>
			</EventNames>
			<Strategies>
			    <StrategyChangeState StateName="Explode"/>
			</Strategies>
		</EventHandler>
	</EventHandlers>
</GameObjectState>