<GameObject Type="PlayerBullet">
    <Properties>
            <Property Name="Speed" Value="20"/>
    </Properties>

    <Strategies>
        <StrategyGlobalCounter PropertyName="BulletPlayer2Count"/>
    </Strategies>
    
    <GameObjectView ModelName="data/objects/Bullet_red.scene"/>
    
    <GameObjectStates>
        <GameObjectState Name="Default" 
                TemplateName="data/objects/collision_with_enemy.state"
                TemplateName="data/objects/collision_with_player.state"
                TemplateName="data/objects/collision_with_enemy_bullet.state"              
                TemplateName="data/objects/collision_with_object.state">
            <GameObjectStateView AnimationName="data/objects/bullet.anim"/>
            <Strategies>
                <StrategyMoveBullet CollisionState="Explode" Mask="1"/>
            </Strategies>
        </GameObjectState>

        <GameObjectState Name="Explode">
            <EventHandlers>
                <EventHandler>
                    <EventNames>
                        <EventName Name="AnimFinished"/>
                    </EventNames>
                    <Strategies>                                    
                        <StrategyChangeState StateName="Dead"/>
                    </Strategies>
                </EventHandler>
            </EventHandlers>
            <Strategies>
                <StrategyGlobalCounter PropertyName="BulletPlayer2Count" Step="-1"/>
                <StrategyMask Mask="0"/>
            </Strategies>
            <GameObjectStateView AnimationName="data/objects/bullet_explode.anim" Loop="false"/>  
        </GameObjectState>
        <GameObjectState Name="Dead"/>

    </GameObjectStates>
    


</GameObject>
