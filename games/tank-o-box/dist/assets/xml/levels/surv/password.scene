<?xml version="1.0"?>
<?v1?>

<Scene>
    <Node Name="_night" Children="data/interface/_night.scene"/>

    <Text Name="header" Position="0 5.5 -15" Rotation="-1.57 0 0" Scale="4 4 4" Font="data/fonts/bc.font" Alignment="CENTER" 
        Text="PASSWORD!">
        <#Shader#>
            <Material Transparency="0.001" Emissive="0.8 0.8 0.7"/>
            <Emissive Image="data/fonts/bc"/>
        </#Shader#>
    </Text>

    <Text Name="txtPassword" Position="0 5.5 -9" Rotation="-1.57 0 0" Scale="4 4 4" Font="data/fonts/bc.font" Alignment="CENTER" 
        Text="">
        <#Shader#>
            <Material Transparency="0.001" Emissive="0.8 0.8 0.8"/>
            <Emissive Image="data/fonts/bc"/>
        </#Shader#>
    </Text>

    <Text Name="" Position="0 5.5 -5" Rotation="-1.57 0 0" Scale="4 4 4" Font="data/fonts/hiscore_small.font" Alignment="CENTER" 
        Text="Please write this password down on a ">
        <#Shader#>
            <Material Transparency="0.001" Emissive="1 1 1"/>
            <Emissive Image="data/fonts/hiscore_small"/>
        </#Shader#>
    </Text>

    <Text Name="" Position="0 5.5 -2.5" Rotation="-1.57 0 0" Scale="4 4 4" Font="data/fonts/hiscore_small.font" Alignment="CENTER"
        Text="sheet of paper. With this password, ">
        <#Shader#>
            <Material Transparency="0.001" Emissive="1 1 1"/>
            <Emissive Image="data/fonts/hiscore_small"/>
        </#Shader#>
    </Text>


    <Text Name="nick2" Position="0 5.5 0" Rotation="-1.57 0 0" Scale="4 4 4" Font="data/fonts/hiscore_small.font" Alignment="CENTER"
        Text="you will be able to start from this ">
        <#Shader#>
            <Material Transparency="0.001" Emissive="1 1 1"/>
            <Emissive Image="data/fonts/hiscore_small"/>
        </#Shader#>
    </Text>

    <Text Name="nick3" Position="0 5.5 2.5" Rotation="-1.57 0 0" Scale="4 4 4" Font="data/fonts/hiscore_small.font" Alignment="CENTER"
        Text="point when you play next time. Just ">
        <#Shader#>
            <Material Transparency="0.001" Emissive="1 1 1"/>
            <Emissive Image="data/fonts/hiscore_small"/>
        </#Shader#>
    </Text>

    <Text Name="nick4" Position="0 5.5 5" Rotation="-1.57 0 0" Scale="4 4 4" Font="data/fonts/hiscore_small.font" Alignment="CENTER"
        Text="choose PASSWORD in the Main ">
        <#Shader#>
            <Material Transparency="0.001" Emissive="1 1 1"/>
            <Emissive Image="data/fonts/hiscore_small"/>
        </#Shader#>
    </Text>

    <Text Name="nick5" Position="0 5.5 7.5" Rotation="-1.57 0 0" Scale="4 4 4" Font="data/fonts/hiscore_small.font" Alignment="CENTER"
        Text="Menu, type in the password and hit ">
        <#Shader#>
            <Material Transparency="0.001" Emissive="1 1 1"/>
            <Emissive Image="data/fonts/hiscore_small"/>
        </#Shader#>
    </Text>

    <Text Name="nick6" Position="0 5.5 10" Rotation="-1.57 0 0" Scale="4 4 4" Font="data/fonts/hiscore_small.font" Alignment="CENTER"
        Text="ENTER">
        <#Shader#>
            <Material Transparency="0.001" Emissive="1 1 1"/>
            <Emissive Image="data/fonts/hiscore_small"/>
        </#Shader#>
    </Text>
    
    <Text Name="nick7" Position="0 5.5 7.5" Rotation="-1.57 0 0" Scale="4 4 4" Font="data/fonts/hiscore_small.font" Alignment="CENTER">
        <#Shader#>
            <Material Transparency="0.001" Emissive="1 1 1"/>
            <Emissive Image="data/fonts/hiscore_small"/>
        </#Shader#>
    </Text>
    
    <Text Name="nick8" Position="0 5.5 10" Rotation="-1.57 0 0" Scale="4 4 4" Font="data/fonts/hiscore_small.font" Alignment="CENTER">
        <#Shader#>
            <Material Transparency="0.001" Emissive="1 1 1"/>
            <Emissive Image="data/fonts/hiscore_small"/>
        </#Shader#>
    </Text>

    <Text Name="nick9" Position="0 5.5 12.5" Rotation="-1.57 0 0" Scale="4 4 4" Font="data/fonts/hiscore_small.font" Alignment="CENTER">
        <#Shader#>
            <Material Transparency="0.001" Emissive="1 1 1"/>
            <Emissive Image="data/fonts/hiscore_small"/>
        </#Shader#>
    </Text>

    <Text Name="btnNext" Position="0 5.5 15" Rotation="-1.57 0 0" Scale="4 4 4" Font="data/fonts/bc.font" Alignment="CENTER" Text="NEXT">
        <#Shader#>
            <Material Transparency="0.001" Emissive="0.7 0.7 0.7"/>
            <Emissive Image="data/fonts/bc"/>
        </#Shader#>
        <HitNode Position="0 0 -2.75" Height="0.1" Width="0.35"/>
    </Text>
     <Text Name="btnNextHint" Position="-22 5.5 21" Rotation="-1.57 0 0" Scale="3 3 3" Font="data/fonts/hiscore_small.font" Alignment="RIGHT" Text="(Enter or Fire)">
        <#Shader#>
            <Material Transparency="0.001" Emissive="1 1 1"/>
            <Emissive Image="data/fonts/hiscore_small"/>
        </#Shader#>
    </Text>
</Scene>
