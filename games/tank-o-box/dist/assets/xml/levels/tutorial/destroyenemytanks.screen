<InterfaceScreenMenu 
        ModelName="data/Levels/Tutorial/DestroyEnemyTanks.scene" 
        AnimationName="data/Interface/_night.anim" 
        Cursor="data/interface/cursor"
        Music="data/music/menu">
    <Controls>
        <ControlButton KeyboardAlias="GCMenuSelect" Name="data/Interface/EmissiveButton_" NodeName="btnNext" Link="Next"/>
        <ControlButton KeyboardAlias="GCMenuBack" Name="data/Interface/EmissiveButton_" NodeName="btnMenu" Link="data/interface/MainMenu.screen"/>
        
        <ControlInputSelector
            PropertyEnabledName="Dumb"
            Name="data/Interface/EmissiveButton_" 
            NodeName="btnInput1"
            SelectorModelNode="deviceModel1"
            HardwareModelPath="data/interface/"
            DefaultHardwareName="GC_KeyboardLayout_1"
            HardwarePropertyName="Player1InputDevice"
        />
    </Controls>
</InterfaceScreenMenu>