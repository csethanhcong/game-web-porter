<InterfaceScreenLevelSquare   
    GameMenuLink="data/interface/GameMenu.screen"
    AnimationName="data/Levels/level1.anim" 
    Music="data/music/positive">
<Controls>  
    <ControlLabel PropertyName="Score" NodeName="txtScore"/>
    <ControlLabel PropertyName="GenerateTank6Total" NodeName="txtEnemyCount0"/>
    <ControlLabel PropertyName="GenerateTank4Total" NodeName="txtEnemyCount1"/>
    <ControlLabel PropertyName="GenerateTank3Total" NodeName="txtEnemyCount2"/>
    <ControlLabel PropertyName="GenerateTank2Total" NodeName="txtEnemyCount3"/>
    <ControlLabel PropertyName="GenerateTank5Total" NodeName="txtEnemyCount4"/>
    <ControlLabel PropertyName="LevelName" NodeName="LevelName" Timeout="5"/>
    <ControlLabel PropertyName="MissionStatus" NodeName="MissionStatus"/>

    <ControlProgressBar PropertyName="BonusUpgrade" NodeName="player1upgrade" MaxValue="3" AnimationName="data/levels/upgrade.anim"/>
    <ControlProgressBar PropertyName="HitPoints" NodeName="indikator2_0_pPlane4" MaxPropertyName="HitPointsMax" AnimationName="data/levels/hitpoints.anim" Speed="0.25"/>
</Controls>
<Properties>    
    <Property Name="GenerateTank2" Value="0"/>
    <Property Name="GenerateTank2Total" Value="0"/>
    <Property Name="GenerateTank2CatchMe" Value="0"/>
    <Property Name="GenerateTank2CatchMeTotal" Value="0"/>
    <Property Name="GenerateTank3" Value="0"/>
    <Property Name="GenerateTank3Total" Value="0"/>
    <Property Name="GenerateTank3Firepower" Value="0" />
    <Property Name="GenerateTank3FirepowerTotal" Value="0" />
    <Property Name="GenerateTank4" Value="0"/>
    <Property Name="GenerateTank4Total" Value="0"/>
    <Property Name="GenerateTank5" Value="0"/>
    <Property Name="GenerateTank5Total" Value="0"/>
    <Property Name="GenerateTank5Duel" Value="0"/>
    <Property Name="GenerateTank5DuelTotal" Value="0"/>
    <Property Name="GenerateTank6" Value="0"/>
    <Property Name="GenerateTank6Total" Value="0"/>
    
    <Property Name="ProbBonusFast" Value="0.05"/>
    <Property Name="ProbBonusUpgrade" Value="0.2"/>  
    <Property Name="ProbBonusArmor" Value="0.070175439"/>
    <Property Name="ProbBonusShtabArmor" Value="0.075471698"/>
    <Property Name="ProbBonusTimeStop" Value="0.06122449"/>
    <Property Name="ProbBonusAirStrike" Value="0.026086957"/>

    <Property Name="TankCountPlayer" Value="0"/>
    <Property Name="TankCountEnemy" Value="0"/>
    <Property Name="ObjectRadarCount" Value="0"/>
    <Property Name="BulletPlayerCount" Value="0"/>
    <Property Name="BulletPlayer2Count" Value="0"/>
    <Property Name="BulletRocketPlayerCount" Value="0"/>
    <Property Name="BulletRocketPlayer2Count" Value="0"/>
    <Property Name="BonusScore" Value="0"/>
    <Property Name="Score" Value="0"/>
    <Property Name="MissionStatus" Value=""/>    
</Properties>
<Level CornerNode="Corner" VectorX="-1 0 0" VectorY="0 0 1" Height="45" Width="45">
    <OffFieldObject TemplateName="data/objects/level_camera.object" />
    <OffFieldObject TemplateName="data/objects/level_force_effects.object" />
    <OffFieldObject TemplateName="data/objects/level_force_effects2.object" />
    <OffFieldObject TemplateName="data/objects/win_detector_player.object" />
    <OffFieldObject TemplateName="data/objects/win_detector_enemy.object" />
    <OffFieldObject TemplateName="data/objects/level_listener.object" />
</Level>
</InterfaceScreenLevelSquare>
