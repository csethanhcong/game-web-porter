<GameObject>
    <GameObjectStates>
    <GameObjectState Name="HiddenUpgrade0">
        <EventHandlers>
            <EventHandler>
                <EventNames>
                    <EventName Name="AnimFinished"/>
                </EventNames>
                <Strategies> 
                    <StrategySetGlobalProperty PropertyName="HitPoints2" ProcValue="2"/>
                    <StrategySetGlobalProperty PropertyName="HitPointsMax2" ProcValue="2"/>
                    <StrategyChangeState StateName="Landing"/>
                </Strategies>
             </EventHandler>
        </EventHandlers>
        <Strategies>
            <StrategyMask Mask = "000 000 000"/>
        </Strategies>
        <GameObjectStateView AnimationName="data/objects/hidden_upgrade0.anim" Loop="false"/>
    </GameObjectState>

