<?xml version="1.0"?>
<?v1?>

<Scene>    
    <Node Name="snd_death0" Children="data/sounds/fire.scene"/>
    <Node Name="snd_explode" Children="data/sounds/object_explode.scene"/>
    
    <Node Name="explode_particles" Children="data/objects/explode_particles.scene"/>

    <ParticleSystem Name="Fire" Visibility="true" Position="0 -1 0"
            Source="data/emitters/emitter_bullet.model"
            ParticlesPerSec="0" ParticlesEmit="0" LifeTime="0.5" LifeVar="0"
            Speed="3" SpeedVar="0"
            SizeStart="1" SizeEnd="0" SizeVar="0"
            ColorStart="1 0.3 0" ColorEnd="0 0 0" ColorVar="0 0 0"
            AlphaStart="0" AlphaEnd="0" AlphaVar="0"
            AttractiveForce="0" Gravity="0 0 0">
        <#Shader#>
            <Material/>
            <Emissive Image="data/textures/fire"/>
        </#Shader#>
    </ParticleSystem>

    <Node Name="live">
        <ModelFixed Name="pCylinder1" Source="data/objects/models/bochka_1x1_pCylinder1-bochka_1x1_live.model" >
            <#Shaders#>
                <Shader Name="phong1" TrianglesCount="20">
                    <Material SpecularPower="40" Diffuse="1 1 1" Specular="0.5 0.5 0.5"/>
                    <Diffuse Image="data/objects/textures/house1"/>
                </Shader>
            </#Shaders#>
        </ModelFixed>
	<Node Name="shadow_0" Visibility="false"  Children="data/objects/bochka_1x1_shadow_0.scene"/>
	<Node Name="shadow_90" Visibility="false"  Children="data/objects/bochka_1x1_shadow_90.scene"/>
	<Node Name="shadow_180" Visibility="false"  Children="data/objects/bochka_1x1_shadow_180.scene"/>
	<Node Name="shadow_270" Visibility="false"  Children="data/objects/bochka_1x1_shadow_270.scene"/>
    </Node>
    <Node Name="death0" Visibility="false">
        <ModelFixed Name="pCylinder1" Source="data/objects/models/bochka_1x1_pCylinder1-bochka_1x1_death0.model" >
            <#Shaders#>
                <Shader Name="phong1" TrianglesCount="16">
                    <Material SpecularPower="40" Diffuse="1 1 1" Specular="0.5 0.5 0.5"/>
                    <Diffuse Image="data/objects/textures/house1"/>
                </Shader>
            </#Shaders#>
        </ModelFixed>
    </Node>
</Scene>
