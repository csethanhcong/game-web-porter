<GameObjectState>
    <EventHandlers>
        <EventHandler>
            <EventNames>
                <EventName Name="CollisionTankLand"/>
                <EventName Name="CollisionPlayerLand"/>
            </EventNames>
            <Strategies>
                <StrategyChangeState StateName="Explode"/>
            </Strategies>
         </EventHandler>

         <EventHandler>
            <EventNames>
                <EventName Name="CollisionTankBonusFast"/>
            </EventNames>
            <Strategies>
                <StrategyChangeCounter PropertyName="BonusFast" Step="15"/>
            </Strategies>
         </EventHandler>

         <EventHandler>
            <EventNames>
                <EventName Name="CollisionTankBonusArmor"/>
            </EventNames>
            <Strategies>
                <StrategyChangeCounter PropertyName="BonusArmor" Step="20"/>
            </Strategies>
         </EventHandler>

         <EventHandler>
            <EventNames>
                <EventName Name="CollisionTankBonusShtabArmor"/>
            </EventNames>
            <Strategies>
                <StrategyGlobalEvent EventName="BonusShtabArmor"/>
            </Strategies>
         </EventHandler>

         <EventHandler>
            <EventNames>
                <EventName Name="CollisionTankBonusTimeStop"/>
            </EventNames>
            <Strategies>
                <StrategyGlobalEvent EventName="BonusTimeStop"/>
            </Strategies>
         </EventHandler>

         <EventHandler>
            <EventNames>
                <EventName Name="CollisionTankBonusAirStrike"/>
            </EventNames>
            <Strategies>
                <StrategyGlobalEvent EventName="BonusAirStrike"/>
            </Strategies>
         </EventHandler>

         <EventHandler>
            <EventNames>
                <EventName Name="CollisionTankBonusUpgrade"/>
            </EventNames>
            <Strategies>
                <StrategyGlobalEvent EventName="PlayerUpgrade2"/>
                <StrategyChangeGlobalCounter PropertyName="BonusUpgrade2" Step="1"/>
                <StrategyChangeStateByGlobalCounter StateName="NoUpgrade" PropertyName="BonusUpgrade2" MinValue="0" MaxValue="1"/>
                <StrategyChangeStateByGlobalCounter StateName="preUpgrade1" PropertyName="BonusUpgrade2" MinValue="1" MaxValue="2"/>
                <StrategyCheckUpgrade HPPropertyName="HitPoints2" MaxHP ="3" UpgradePropertyName="BonusUpgrade2" MaxUpgrade="3"/>
                <StrategyChangeStateByGlobalCounter StateName="preUpgrade2" PropertyName="BonusUpgrade2" MinValue="2" MaxValue="3"/>
            </Strategies>
         </EventHandler>


    </EventHandlers>

    <Strategies>
        <StrategyChangeStateByGlobalCounter StateName="Explode" PropertyName="HitPoints2" MinValue="-9999" MaxValue="1"/>
        <StrategyMoveByKey InputDevicePropertyName="Player2InputDevice" Mask = "111 111 111"/>      
    </Strategies>
</GameObjectState>

