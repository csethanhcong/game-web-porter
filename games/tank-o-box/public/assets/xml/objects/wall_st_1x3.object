<GameObject Type="Object">
    <GameObjectView ModelName="data/objects/wall_st_1x3.scene"/>

	<Properties>
		<Property Name="HitPoints" Value="3"/>
		<Property Name="Damage" Value="-1"/>
	    <Property Name="DamageDouble" Value="-2"/>
	    <Property Name="DamageRocket" Value="-3"/>
	</Properties>

    <GameObjectStates>
		<GameObjectState Name="Default" TemplateName="data/objects/object_collision.state">
			<GameObjectStateView AnimationName="data/objects/wall_st_1x3.anim"/>
			<Strategies>
				<StrategyChangeStateByCounter StateName="Exploding1" PropertyName="HitPoints" MinValue="-9999" MaxValue="3"/>
				<StrategyMask Mask = "111"/>
				<StrategyShadow MainNode="live" ShadowName="shadow"/>
			</Strategies>
		</GameObjectState>

		<GameObjectState Name="Exploding1">
			<EventHandlers>
				<EventHandler>
	                <EventNames>
	                    <EventName Name="AnimFinished"/>
	                </EventNames>
	                <Strategies>                	
	                    <StrategyChangeState StateName="Death1"/>
	                </Strategies>
	             </EventHandler>
	       </EventHandlers>
	       <Strategies>
				<StrategyMask Mask = "111"/>
			<StrategyShadow MainNode="death0" ShadowName="shadow"/>
			</Strategies>
	       <GameObjectStateView AnimationName="data/objects/wall_death1.anim" Loop="false"/>
		</GameObjectState>

		<GameObjectState Name="Death1" TemplateName="data/objects/object_collision.state">
		    <GameObjectStateView AnimationName="data/objects/wall_st_1x3.anim"/>
		    <Strategies>
			<StrategyShadow MainNode="death0" ShadowName="shadow"/>
		    	<StrategyChangeStateByCounter StateName="Exploding2" PropertyName="HitPoints" MinValue="-9999" MaxValue="1"/>
		    	<StrategyMask Mask = "111"/>
		    </Strategies>
		</GameObjectState>

		<GameObjectState Name="Exploding2">
			<EventHandlers>
				<EventHandler>
	                <EventNames>
	                    <EventName Name="AnimFinished"/>
	                </EventNames>
	                <Strategies>                	
	                    <StrategyChangeState StateName="Death2"/>
	                </Strategies>
	             </EventHandler>
	       </EventHandlers>
	       <Strategies>
				<StrategyMask Mask = "111"/>
			</Strategies>
	       <GameObjectStateView AnimationName="data/objects/wall_death2.anim" Loop="false"/>
		</GameObjectState>

		<GameObjectState Name="Death2" TemplateName="data/objects/object_collision.state">
			<GameObjectStateView AnimationName="data/objects/wall_st_1x3.anim"/>
		    <Strategies>
		    	<StrategyMask Mask = "000"/>
		    </Strategies>
		</GameObjectState>
    </GameObjectStates>

</GameObject>
