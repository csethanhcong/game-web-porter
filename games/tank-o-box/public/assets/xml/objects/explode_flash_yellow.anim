<?xml version="1.0"?>
<?v1?>

<Animation>
    <double>
        <PrimitiveAnimation Target="explode_flash_yellow|point1" Param="Intensity">
            <Envelope PreBehave="CONSTANT" PostBehave="CONSTANT">
                <Keys>
                <Key Time="0" Linear="500" Quadratic="0" Cubic="0" Value="50"/>
                <Key Time="0.1" Linear="-1000" Quadratic="0" Cubic="0" Value="100"/>
                <Key Time="0.2" Linear="500" Quadratic="0" Cubic="0" Value="0"/>
                <Key Time="0.3" Linear="-500" Quadratic="0" Cubic="0" Value="50"/>
                <Key Time="0.4" Linear="0" Quadratic="0" Cubic="0" Value="0"/>
                </Keys>
            </Envelope>
        </PrimitiveAnimation>
    </double>
</Animation>
