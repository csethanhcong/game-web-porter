					<Key Time="0" Linear="0" Quadratic="0" Cubic="0.0" Value="0"/>
				</Keys>
			</Envelope>
		</PrimitiveAnimation>
		<PrimitiveAnimation Target="death1" Param="Visibility">
			<Envelope PreBehave="CONSTANT" PostBehave="CONSTANT">
				<Keys>
					<Key Time="0" Linear="0" Quadratic="0" Cubic="0.000" Value="0"/>
				</Keys>
			</Envelope>
		</PrimitiveAnimation>
		<PrimitiveAnimation Target="death2" Param="Visibility">
			<Envelope PreBehave="CONSTANT" PostBehave="CONSTANT">
				<Keys>
					<Key Time="0" Linear="0" Quadratic="0" Cubic="0.000" Value="0"/>
				</Keys>
			</Envelope>
		</PrimitiveAnimation>
		<PrimitiveAnimation Target="death3" Param="Visibility">
			<Envelope PreBehave="CONSTANT" PostBehave="CONSTANT">
				<Keys>
					<Key Time="0" Linear="0" Quadratic="0" Cubic="0.000" Value="0"/>
				</Keys>
			</Envelope>
		</PrimitiveAnimation>

	</double>
</Animation>
