<?xml version="1.0"?>
<?v1?>

<Animation>
    <math::Vector[float,3]>
        <PrimitiveAnimation Target="#Shader#" Param="Emissive">
            <Envelope PreBehave="CONSTANT" PostBehave="CONSTANT">
                <Keys>
                    <Key Time="0" Linear="0 0 0" Value="0.7 0.7 0.7"/>
                </Keys>
            </Envelope>
        </PrimitiveAnimation>
    </math::Vector[float,3]>
    <double>
        <!PrimitiveAnimation Target="" Param="Visibility">
            <Envelope PreBehave="CONSTANT" PostBehave="CONSTANT">
                <Keys>
                    <Key Time="0" Linear="0" Quadratic="0" Cubic="0" Value="1"/>
                </Keys>
            </Envelope>
        </PrimitiveAnimation!>
    </double>
</Animation>
