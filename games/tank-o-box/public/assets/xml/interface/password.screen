<InterfaceScreenMenu 
        ModelName="data/interface/Password.scene" 
        AnimationName="data/Interface/_night.anim" 
        Cursor="data/interface/cursor"
        Music="data/music/menu">
    <Controls>
        <ControlPassword NodeName="Password"  MaxLength="6" Link="data/interface/game.screen">
            <Entry Password="attack" GraphNodeName="16" LevelName="LEVEL 6" EpisodeLink="data/levels/episode1.episode" EpisodeName="1 PLAYER"/>
            <Entry Password="beaver" GraphNodeName="28" LevelName="LEVEL 11" EpisodeLink="data/levels/episode1.episode" EpisodeName="1 PLAYER"/>
            <Entry Password="spider" GraphNodeName="41" LevelName="LEVEL 16" EpisodeLink="data/levels/episode1.episode" EpisodeName="1 PLAYER"/>
            <Entry Password="gadget" GraphNodeName="52" LevelName="LEVEL 21" EpisodeLink="data/levels/episode1.episode" EpisodeName="1 PLAYER"/>
            <Entry Password="market" GraphNodeName="66" LevelName="LEVEL 26" EpisodeLink="data/levels/episode1.episode" EpisodeName="1 PLAYER"/>
            <Entry Password="rabbit" GraphNodeName="78" LevelName="LEVEL 31" EpisodeLink="data/levels/episode1.episode" EpisodeName="1 PLAYER"/>
            <Entry Password="sunday" GraphNodeName="89" LevelName="LEVEL 36" EpisodeLink="data/levels/episode1.episode" EpisodeName="1 PLAYER"/>
            <Entry Password="napalm" GraphNodeName="100" LevelName="LEVEL 41" EpisodeLink="data/levels/episode1.episode" EpisodeName="1 PLAYER"/>
            <Entry Password="needle" GraphNodeName="112" LevelName="LEVEL 46" EpisodeLink="data/levels/episode1.episode" EpisodeName="1 PLAYER"/>
            <Entry Password="battle" GraphNodeName="123" LevelName="LEVEL 51" EpisodeLink="data/levels/episode1.episode" EpisodeName="1 PLAYER"/>

            <Entry Password="healer" GraphNodeName="16" LevelName="LEVEL 6" EpisodeLink="data/levels/episode2.episode" EpisodeName="2 PLAYER"/>
            <Entry Password="dagger" GraphNodeName="28" LevelName="LEVEL 11" EpisodeLink="data/levels/episode2.episode" EpisodeName="2 PLAYER"/>
            <Entry Password="factor" GraphNodeName="41" LevelName="LEVEL 16" EpisodeLink="data/levels/episode2.episode" EpisodeName="2 PLAYER"/>
            <Entry Password="ladder" GraphNodeName="52" LevelName="LEVEL 21" EpisodeLink="data/levels/episode2.episode" EpisodeName="2 PLAYER"/>
            <Entry Password="python" GraphNodeName="66" LevelName="LEVEL 26" EpisodeLink="data/levels/episode2.episode" EpisodeName="2 PLAYER"/>
            <Entry Password="racket" GraphNodeName="78" LevelName="LEVEL 31" EpisodeLink="data/levels/episode2.episode" EpisodeName="2 PLAYER"/>
            <Entry Password="voyage" GraphNodeName="89" LevelName="LEVEL 36" EpisodeLink="data/levels/episode2.episode" EpisodeName="2 PLAYER"/>
            <Entry Password="median" GraphNodeName="100" LevelName="LEVEL 41" EpisodeLink="data/levels/episode2.episode" EpisodeName="2 PLAYER"/>
            <Entry Password="caesar" GraphNodeName="112" LevelName="LEVEL 46" EpisodeLink="data/levels/episode2.episode" EpisodeName="2 PLAYER"/>
            <Entry Password="goblin" GraphNodeName="123" LevelName="LEVEL 51" EpisodeLink="data/levels/episode2.episode" EpisodeName="2 PLAYER"/>
        </ControlPassword>      
        <ControlLabel PropertyName="EpisodeName" NodeName="GameEpisode"/>
        <ControlLabel PropertyName="LevelName" NodeName="GameLevel"/>
        <ControlButton Link="data/interface/game.screen" PropertyEnabledName="EpisodeLink" Name="data/Interface/EmissiveButton_" NodeName="btnNext"/>
        <ControlButton KeyboardAlias="GCMenuBack" Name="data/Interface/EmissiveButton_" NodeName="btnBack" Link="data/interface/MainMenu.screen"/>
    </Controls>
</InterfaceScreenMenu> 